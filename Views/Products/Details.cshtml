@model FashionShop.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: cover;">
            }
            else
            {
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                    <span class="text-muted">No Image Available</span>
                </div>
            }
            <div class="card-body">
                <h2 class="card-title">@Model.Name</h2>
                <p class="text-muted">@Model.Category.Name</p>
                <h3 class="text-primary">@Model.Price.ToString("C")</h3>
                <p class="card-text">@Model.Description</p>
                <p class="text-muted">Stock: @Model.StockQuantity items</p>
                
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Quick Actions</h5>
            </div>
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Add" asp-controller="Cart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantity:</label>
                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                    </form>
                }
                else
                {
                    <p class="text-muted">Please <a asp-action="Login" asp-controller="Account">login</a> to add to cart.</p>
                }
            </div>
        </div>
    </div>
</div>