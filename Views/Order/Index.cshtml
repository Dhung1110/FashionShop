@model IEnumerable<FashionShop.Models.Order>
@using FashionShop.Models

@{
    ViewData["Title"] = "Order History";
}

<div class="container mt-5">
    <h2 class="mb-4">Order History</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You have no orders yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-bold text-success">@order.TotalAmount.ToString("C")</td>
                            <td>
                                <span class="badge bg-@(order.Status == OrderStatus.Pending ? "warning" : "success")">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" 
                                   class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i> View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Checkout" class="btn btn-success">
            <i class="fas fa-shopping-cart"></i> New Order
        </a>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}