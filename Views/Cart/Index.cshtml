@model IEnumerable<FashionShop.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
    <h2 class="mb-4">
        <i class="fas fa-shopping-cart"></i> Shopping Cart
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Your cart is empty.
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary ms-2">
                <i class="fas fa-shopping-bag"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Your Items</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (item.Product?.ImageUrl != null)
                                            {
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" 
                                                     class="img-thumbnail me-3" style="width: 50px; height: 50px;" />
                                            }
                                            <div>
                                                <h6 class="mb-0">@item.Product?.Name</h6>
                                                <small class="text-muted">@item.Product?.Category?.Name</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantity" 
                                                   min="1" max="99" class="form-control d-inline-block" 
                                                   style="width: 80px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary ms-1">
                                                Update
                                            </button>
                                        </form>
                                    </td>
                                    <td class="fw-bold">@item.TotalPrice.ToString("C")</td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-md-6">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="mb-3">
                            <h5>Subtotal: <span class="text-success fw-bold">@Model.Sum(i => i.TotalPrice).ToString("C")</span></h5>
                            <h5>Shipping: <span class="text-info fw-bold">30,000 VND</span></h5>
                            <h4>Total: <span class="text-danger fw-bold">@((Model.Sum(i => i.TotalPrice) + 30000).ToString("C"))</span></h4>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg">
                            <i class="fas fa-credit-card"></i> Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script>
        function updateQuantity(id, quantity) {
            if (quantity < 1) quantity = 1;
            if (quantity > 99) quantity = 99;
            
            fetch(`/Cart/UpdateQuantity?id=${id}&quantity=${quantity}`, {
                method: 'POST'
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        }
    </script>
}